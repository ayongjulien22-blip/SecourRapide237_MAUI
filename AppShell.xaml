<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SecourRapide237.MAUI.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:Pages="clr-namespace:SecourRapide237.MAUI.Pages"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!--
        Plus de TabBar natif (c'était lui qui affichait les onglets en haut).
        La navigation du bas est maintenant le contrôle Controls/BottomNav,
        placé dans chaque page principale.
    -->
    <ShellContent Route="LoginPage"      ContentTemplate="{DataTemplate Pages:LoginPage}" />
    <ShellContent Route="HomePage"       ContentTemplate="{DataTemplate Pages:HomePage}" />
    <ShellContent Route="GuidePage"      ContentTemplate="{DataTemplate Pages:GuidePage}" />
    <ShellContent Route="SOSPage"        ContentTemplate="{DataTemplate Pages:SOSPage}" />
    <ShellContent Route="HistoriquePage" ContentTemplate="{DataTemplate Pages:HistoriquePage}" />
    <ShellContent Route="ProfilPage"     ContentTemplate="{DataTemplate Pages:ProfilPage}" />
    <ShellContent Route="SMSPage"        ContentTemplate="{DataTemplate Pages:SMSPage}" />
    <ShellContent Route="HorsLignePage"  ContentTemplate="{DataTemplate Pages:HorsLignePage}" />
</Shell>
