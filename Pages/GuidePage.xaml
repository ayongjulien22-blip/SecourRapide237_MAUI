<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SecourRapide237.MAUI.Controls"
             xmlns:models="clr-namespace:SecourRapide237.MAUI.Models"
             x:Class="SecourRapide237.MAUI.Pages.GuidePage"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader Grid.Row="0" Title="Guide de premiers secours" BackRoute="HomePage" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,24" Spacing="12">

                <Label Text="Protéger · Alerter · Secourir" Style="{StaticResource ScreenTitle}" FontSize="22" />
                <Label Text="Les 3 réflexes à avoir devant n'importe quelle urgence." Style="{StaticResource Caption}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="1. Protéger" FontAttributes="Bold" Style="{StaticResource BodyText}" />
                        <Label Text="Regardez autour de vous, écartez le danger, coupez le moteur, mettez un gilet." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="2. Alerter : 112 / 119" FontAttributes="Bold" Style="{StaticResource BodyText}" />
                        <Label Text="Donnez la position exacte, le nombre de victimes et leur état." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="3. Secourir" FontAttributes="Bold" Style="{StaticResource BodyText}" />
                        <Label Text="Compression si saignement, position latérale si inconscient. Ne déplacez pas une victime sans nécessité." Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Fiches par situation" Style="{StaticResource BodyText}" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0" />

                <VerticalStackLayout x:Name="ListeFiches" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Fiche">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFicheTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{Binding Teinte}" WidthRequest="46" HeightRequest="46" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="23" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Emoji}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Titre}" Style="{StaticResource BodyText}"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Style="{StaticResource OkCard}" Margin="0,6,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHorsLigneTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Espace hors ligne" FontAttributes="Bold" TextColor="{StaticResource OkText}" />
                            <Label Text="Tous les guides marchent sans internet." Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="26" TextColor="{StaticResource OkText}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="2" Active="Guide" />
    </Grid>
</ContentPage>
