<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SecourRapide237.MAUI.Controls"
             xmlns:models="clr-namespace:SecourRapide237.MAUI.Models"
             x:Class="SecourRapide237.MAUI.Pages.HorsLignePage"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">

        <controls:PageHeader Grid.Row="0" Title="Espace hors ligne" BackRoute="GuidePage" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,24" Spacing="12">

                <Label Text="Prêts, même hors ligne." Style="{StaticResource ScreenTitle}" />
                <Label Text="Vos guides sont enregistrés dans l'application et fonctionnent sans internet."
                       Style="{StaticResource Caption}" />

                <Border Style="{StaticResource OkCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="NombreLabel" Text="✓  6 guides enregistrés" FontAttributes="Bold"
                               TextColor="{StaticResource OkText}" />
                        <Label x:Name="ReseauLabel" Text="" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="GUIDES DISPONIBLES" Style="{StaticResource Overline}" Margin="0,6,0,0" />

                <VerticalStackLayout x:Name="ListeFiches" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Fiche">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFicheTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{Binding Teinte}" WidthRequest="42" HeightRequest="42" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="21" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Emoji}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Titre}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                        <Label Text="Disponible hors ligne" FontSize="11" TextColor="{StaticResource OkText}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="✓" FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource OkText}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Gérer les téléchargements" Style="{StaticResource OutlineButton}" Margin="0,8,0,0"
                        Clicked="OnGerer" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="2" Active="Guide" />
    </Grid>
</ContentPage>
